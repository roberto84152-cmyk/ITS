NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/visitcard?schema=public
# Used by docker compose (defaults are fine for local development)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=visitcard

# S3-compatible storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
# Endpoint used to build presigned URLs that the browser can reach.
# In docker-compose the app talks to http://minio:9000, while the browser uses http://localhost:9000.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=visitcard
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
